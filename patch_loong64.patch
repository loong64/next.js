@@ -0,0 +1,10 @@
+#!/bin/bash
+
+set -e
+
+for pkg in packages/*; do
+  if [ -f "${pkg}/package.json" ]; then
+    echo "Publishing $pkg..."
+    pnpm pack "${pkg}"
+  fi
+done
